{
  "name": "source.sffmwave",
  "label": "Single-Frequency FM Wave Source",
  "category": "sources",
  "parameters": [
    { "name": "va", "type": "number", "default": 1.0 },
    { "name": "fc", "type": "number", "default": 1000.0, "unit": "Hz" },
    { "name": "fs", "type": "number", "default": 100.0, "unit": "Hz" },
    { "name": "v0", "type": "number", "default": 0.0 },
    { "name": "mdi", "type": "number", "default": 0.0 }
  ],
  "ports": [{ "id": "out", "side": "right", "kind": "signal", "direction": "out" }],
  "geometry": {
    "bbox": [50, 30],
    "primitives": [
      { "type": "rect", "x": 0, "y": 0, "w": 50, "h": 30 },
      { "type": "text", "x": 25, "y": 15, "text": "SFFM" }
    ]
  }
}
