{
  "name": "extensibility.cscript",
  "label": "C Script",
  "category": "extensibility",
  "parameters": [
    { "name": "lib", "type": "string", "default": "" },
    { "name": "input_names", "type": "array", "default": ["u"] },
    { "name": "output_names", "type": "array", "default": ["y"] },
    {
      "name": "xc_count",
      "type": "integer",
      "default": 0,
      "validate": "${{ value >= 0 }}",
      "error": "xc_count must be non-negative"
    }
  ],
  "ports": [
    {
      "for_each": "${{ range(count(params.input_names)) }}",
      "as": "i",
      "emit": {
        "id": "in${{ i }}",
        "side": "left",
        "kind": "signal",
        "direction": "in",
        "label": "${{ at(params.input_names, i) }}"
      }
    },
    {
      "for_each": "${{ range(count(params.output_names)) }}",
      "as": "i",
      "emit": {
        "id": "out${{ i }}",
        "side": "right",
        "kind": "signal",
        "direction": "out",
        "label": "${{ at(params.output_names, i) }}"
      }
    }
  ],
  "geometry": {
    "bbox": [
      70,
      "${{ max(30, max(count(params.input_names), count(params.output_names)) * 16) }}"
    ],
    "primitives": [{ "type": "text", "x": 35, "y": 15, "text": "C" }]
  }
}
