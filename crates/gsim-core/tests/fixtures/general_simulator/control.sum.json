{
  "name": "control.sum",
  "label": "Sum",
  "category": "control",
  "parameters": [
    {
      "name": "signs",
      "type": "array",
      "default": [1, 1],
      "validate": "${{ count(value) >= 1 && count(value) <= 8 }}",
      "error": "Sum must have between 1 and 8 inputs"
    }
  ],
  "ports": [
    {
      "for_each": "${{ range(count(params.signs)) }}",
      "as": "i",
      "emit": {
        "id": "in${{ i }}",
        "side": "left",
        "kind": "signal",
        "direction": "in",
        "label": "${{ if(at(params.signs, i) < 0, '-', '+') }}"
      }
    },
    { "id": "out", "side": "right", "kind": "signal", "direction": "out" }
  ],
  "geometry": {
    "bbox": [40, "${{ max(30, count(params.signs) * 14) }}"],
    "primitives": [{ "type": "circle", "cx": 20, "cy": 15, "r": 15 }]
  }
}
